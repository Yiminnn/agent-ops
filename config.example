# Copy to ~/.claude/agent-templates/config (or $AGENT_OPS_HOME/config) and fill in. KEY="value" lines, read by bash and Python:
# literal values, with no $VAR, ~ or single quotes.
TEAM_ORG="<Claude org uuid of the company account>"
PROFILES_DIR="<dir with one CLAUDE_CONFIG_DIR per profile>"
CLAUDE_CLI_ROOT="<dir the newest CLI is under: */*/claude.app/Contents/MacOS/claude>"
CLAUDE_CLI=""
WORKER_MODEL="claude-opus-5-5"
PRIMARY_CHECKOUT="<checkout no session may write git to>"
WORK_ROOT="<the work drive>"
LOGS_DIR="<work drive>/logs"
GH_REPOS="<owner/repo owner/repo>"
DEPLOY_REPO="<owner/repo>"
DEPLOY_BRANCH="dev"
BOT_REVIEWERS="codex|claude"
SSO_PROFILE="<aws profile for the SSO check>"
