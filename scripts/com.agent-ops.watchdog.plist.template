<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template, not loaded. Replace __HOME__ and __ALERT_CMD__, copy to ~/Library/LaunchAgents/, then launchctl load. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agent-ops.watchdog</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__HOME__/.claude/agent-templates/plugin/scripts/watchdog.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>AGENT_OPS_ALERT_CMD</key><string>__ALERT_CMD__</string></dict>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>__HOME__/.claude/agent-templates/state/watchdog.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude/agent-templates/state/watchdog.log</string>
</dict>
</plist>
