{
  "description": "agent-ops hooks: one guard (deny_kill, fail closed) and two reports. onFailure has no effect on Stop (documented), and a broken SessionStart must not stop the coordinator from starting.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/deny_kill.py\"", "timeout": 10, "onFailure": "block"}
        ]
      }
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop_status.py\"", "timeout": 10, "onFailure": "continue"}]}
    ],
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_start.sh\"", "timeout": 30, "onFailure": "continue"}]}
    ]
  }
}
